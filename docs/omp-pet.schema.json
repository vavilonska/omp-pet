{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/omp-pet.schema.json",
  "title": "OMP Pet Package",
  "type": "object",
  "required": [
    "id",
    "displayName",
    "spriteVersionNumber",
    "spritesheetPath"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "spriteVersionNumber": {
      "type": "integer",
      "enum": [1, 2]
    },
    "spritesheetPath": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}

