{
  "name": "@omp-pet/omp-extension",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "omp": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --format esm --external @oh-my-pi/pi-coding-agent",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@omp-pet/core": "workspace:*"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "18.0.11"
  }
}
